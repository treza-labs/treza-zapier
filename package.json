    "_zapier-build": "rimraf ./dist ./build && tsc"
  },
  "dependencies": {
    "zapier-platform-core": "19.3.0"
  },
  "devDependencies": {
    "rimraf": "^5.0.10",
    "typescript": "5.6.2",
    "vitest": "^2.1.2"
  },
  "private": true,
  "exports": "./dist/index.js",
  "type": "module",
  "homepage": "https://www.trezalabs.com",
